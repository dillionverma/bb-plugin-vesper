{
  "name": "Vesper Light",
  "type": "light",
  "colors": {
    "editor.background": "#fafafa",
    "editor.foreground": "#101010",
    "editor.selectionBackground": "#10101018",
    "editor.selectionHighlightBackground": "#10101018",
    "editorLineNumber.foreground": "#b0b0b0",
    "editorGroupHeader.tabsBackground": "#fafafa",
    "editorWidget.background": "#fafafa",
    "editorWarning.foreground": "#c2660f",
    "editorError.foreground": "#b83232",
    "editorOverviewRuler.border": "#fafafa",
    "editorGutter.addedBackground": "#158a68",
    "editorGutter.deletedBackground": "#b83232",
    "editorGutter.modifiedBackground": "#c2660f",
    "diffEditor.insertedTextBackground": "#158a6818",
    "diffEditor.insertedLineBackground": "#158a6818",
    "diffEditor.removedTextBackground": "#b8323218",
    "diffEditor.removedLineBackground": "#b8323218",
    "editorInlayHint.foreground": "#6d6d6d",
    "editorInlayHint.background": "#eeeeee",
    "sideBar.background": "#fafafa",
    "sideBarTitle.foreground": "#6d6d6d",
    "sideBarSectionHeader.foreground": "#6d6d6d",
    "sideBarSectionHeader.background": "#fafafa",
    "activityBar.background": "#fafafa",
    "activityBar.foreground": "#6d6d6d",
    "activityBarBadge.background": "#c2660f",
    "activityBarBadge.foreground": "#ffffff",
    "titleBar.activeBackground": "#fafafa",
    "titleBar.inactiveBackground": "#fafafa",
    "titleBar.activeForeground": "#8e8e8e",
    "titleBar.inactiveForeground": "#9c9c9c",
    "tab.border": "#fafafa",
    "tab.activeBackground": "#f4f4f4",
    "tab.activeBorder": "#c2660f",
    "tab.inactiveBackground": "#fafafa",
    "statusBar.debuggingForeground": "#101010",
    "statusBar.debuggingBackground": "#FF7300",
    "statusBar.background": "#fafafa",
    "statusBar.noFolderBackground": "#fafafa",
    "statusBar.foreground": "#6d6d6d",
    "statusBarItem.remoteBackground": "#c2660f",
    "statusBarItem.remoteForeground": "#ffffff",
    "list.activeSelectionForeground": "#c2660f",
    "list.inactiveSelectionBackground": "#e7e7e7",
    "badge.background": "#c2660f",
    "badge.foreground": "#ffffff",
    "button.background": "#c2660f",
    "button.hoverBackground": "#c2660f",
    "button.foreground": "#ffffff",
    "focusBorder": "#c2660f",
    "icon.foreground": "#6d6d6d",
    "input.background": "#eeeeee",
    "list.activeSelectionBackground": "#e7e7e7",
    "list.hoverBackground": "#e3e3e3",
    "list.errorForeground": "#b83232",
    "list.highlightForeground": "#c2660f",
    "selection.background": "#a6a6a6",
    "editorBracketHighlight.foreground1": "#6d6d6d",
    "editorBracketHighlight.foreground2": "#6d6d6d",
    "editorBracketHighlight.foreground3": "#6d6d6d",
    "editorBracketHighlight.foreground4": "#6d6d6d",
    "editorBracketHighlight.foreground5": "#6d6d6d",
    "editorBracketHighlight.foreground6": "#6d6d6d",
    "editorBracketHighlight.unexpectedBracket.foreground": "#b83232",
    "textLink.foreground": "#c2660f",
    "textLink.activeForeground": "#c2660f",
    "editorHoverWidget.background": "#f4f4f4",
    "editorHoverWidget.border": "#e3e3e3",
    "scrollbarSlider.background": "#d7d7d780",
    "scrollbarSlider.hoverBackground": "#d7d7d7",
    "settings.modifiedItemIndicator": "#c2660f"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#82828294"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "string constant.other.placeholder",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#101010"
      }
    },
    {
      "name": "Colors",
      "scope": [
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#101010"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#b83232"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6d6d6d"
      }
    },
    {
      "name": "Operator, Misc",
      "scope": [
        "keyword.control",
        "constant.other.color",
        "punctuation.definition.tag",
        "punctuation.separator.inheritance.php",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html",
        "punctuation.section.embedded",
        "keyword.other.template",
        "keyword.other.substitution"
      ],
      "settings": {
        "foreground": "#6d6d6d"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#c2660f"
      }
    },
    {
      "name": "Function, Special Method",
      "scope": [
        "entity.name.function",
        "variable.function",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#c2660f"
      }
    },
    {
      "name": "Block Level Variables",
      "scope": [
        "meta.block variable.other"
      ],
      "settings": {
        "foreground": "#101010"
      }
    },
    {
      "name": "Other Variable, String Link",
      "scope": [
        "support.other.variable",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#101010"
      }
    },
    {
      "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
      "scope": [
        "constant.numeric",
        "support.constant",
        "constant.character",
        "constant.escape",
        "keyword.other.unit",
        "keyword.other",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#c2660f"
      }
    },
    {
      "name": "String, Symbols, Inherited Class",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.other.key",
        "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "foreground": "#158a68"
      }
    },
    {
      "name": "Class, Support",
      "scope": [
        "entity.name",
        "support.type",
        "support.class",
        "support.other.namespace.use.php",
        "meta.use.php",
        "support.other.namespace.php",
        "markup.changed.git_gutter",
        "support.type.sys-types"
      ],
      "settings": {
        "foreground": "#c2660f"
      }
    },
    {
      "name": "CSS Class and Support",
      "scope": [
        "source.css support.type.property-name",
        "source.sass support.type.property-name",
        "source.scss support.type.property-name",
        "source.less support.type.property-name",
        "source.stylus support.type.property-name",
        "source.postcss support.type.property-name",
        "source.postcss support.type.property-name",
        "support.type.vendored.property-name.css",
        "source.css.scss entity.name.tag",
        "variable.parameter.keyframe-list.css",
        "meta.property-name.css",
        "variable.parameter.url.scss",
        "meta.property-value.scss",
        "meta.property-value.css"
      ],
      "settings": {
        "foreground": "#101010"
      }
    },
    {
      "name": "Sub-methods",
      "scope": [
        "entity.name.module.js",
        "variable.import.parameter.js",
        "variable.other.class.js"
      ],
      "settings": {
        "foreground": "#b83232"
      }
    },
    {
      "name": "Language methods",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#6d6d6d"
      }
    },
    {
      "name": "entity.name.method.js",
      "scope": [
        "entity.name.method.js"
      ],
      "settings": {
        "foreground": "#101010ff"
      }
    },
    {
      "name": "meta.method.js",
      "scope": [
        "meta.class-method.js entity.name.function.js",
        "variable.function.constructor"
      ],
      "settings": {
        "foreground": "#101010ff"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.property-list.scss",
        "meta.attribute-selector.scss",
        "meta.property-value.css",
        "entity.other.keyframe-offset.css",
        "meta.selector.css",
        "entity.name.tag.reference.scss",
        "entity.name.tag.nesting.css",
        "punctuation.separator.key-value.css"
      ],
      "settings": {
        "foreground": "#6d6d6d"
      }
    },
    {
      "name": "HTML Attributes",
      "scope": [
        "text.html.basic entity.other.attribute-name.html",
        "text.html.basic entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#c2660f"
      }
    },
    {
      "name": "CSS Classes",
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id",
        "meta.attribute-selector.scss",
        "variable.parameter.misc.css"
      ],
      "settings": {
        "foreground": "#c2660f"
      }
    },
    {
      "name": "CSS ID's",
      "scope": [
        "source.sass keyword.control",
        "meta.attribute-selector.scss"
      ],
      "settings": {
        "foreground": "#158a68"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#158a68"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#b83232"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#6d6d6d"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#6d6d6d"
      }
    },
    {
      "name": "Escape Characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#6d6d6d"
      }
    },
    {
      "name": "URL",
      "scope": [
        "*url*",
        "*link*",
        "*uri*"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "tag.decorator.js entity.name.tag.js",
        "tag.decorator.js punctuation.definition.tag.js"
      ],
      "settings": {
        "foreground": "#101010ff"
      }
    },
    {
      "name": "ES7 Bind Operator",
      "scope": [
        "source.js constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#b83232"
      }
    },
